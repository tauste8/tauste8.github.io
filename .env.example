# ───────── AUTORECA IA — configuración ─────────
# Contraseña de PostgreSQL (docker-compose)
POSTGRES_PASSWORD=cambie-esta-contraseña

# Clave para cifrar las credenciales de integraciones (obligatoria en producción).
# Genérela con:  openssl rand -hex 32   — y guárdela: si se pierde, habrá que volver a introducir las credenciales.
APP_ENCRYPTION_KEY=

# URL pública (se usa en los enlaces de recuperación de contraseña)
PUBLIC_URL=https://recambios.su-dominio.es

# Si la aplicación está detrás de un proxy inverso con HTTPS (Caddy, Nginx, Traefik…)
TRUST_PROXY=1

# Duración de la sesión en días
SESSION_DAYS=7

# ── Correo saliente (recuperación de contraseña). Opcional. ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=AUTORECA IA <no-reply@su-dominio.es>

# ── Asistente de IA (Claude). Opcional. ──
# Activa la interpretación de denominaciones difíciles y la búsqueda por fotografía.
ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5
